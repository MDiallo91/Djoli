# ─────────────────────────────────────────────────────────────
# SaaS Hub Backend — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs
# ─────────────────────────────────────────────────────────────

# Port du serveur
PORT=3001

# Base de données
# Pour SQLite (dev, hors-ligne, aucune installation) : laissez DATABASE_URL vide → saas-hub/backend/local.db
# Pour MySQL (prod/staging)                          : mysql://user:pass@host:3306/dbname
DATABASE_URL=

# Mettre à true si l'hébergeur MySQL exige une connexion TLS
DB_SSL=false

# JWT — OBLIGATOIRE : remplacer par une vraie clé aléatoire (min 64 chars)
JWT_SECRET=CHANGE-THIS-TO-A-REAL-SECRET-MINIMUM-64-CHARACTERS-LONG-PLEASE

# Durée de validité du token JWT (ex: 3d, 7d, 24h)
JWT_EXPIRES_IN=3d

# Environnement
NODE_ENV=development

# Resend — envoi d'emails (OTP, notifications). Si absent, l'envoi d'email
# est simplement sauté (avec un warning) au lieu de faire échouer la requête.
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
SUPPORT_EMAIL=support@djoli.app

# URL du frontend, utilisée dans les liens contenus dans les emails
FRONTEND_URL=https://djoli.app

# Secret partagé pour signer/vérifier les licences desktop → cloud
LICENSE_SECRET=CHANGE-THIS-TO-A-REAL-SECRET-IN-PROD

# Secret pour l'endpoint ponctuel POST /api/seed/super-admin?secret=...
# Retirer cette variable après le premier seed pour désactiver la route.
SEED_SECRET=

# Optionnel — utilisées par `node create-admin.js` (sinon passer en arguments :
# node create-admin.js email motdepasse "Nom", ou valeurs par défaut sinon).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
